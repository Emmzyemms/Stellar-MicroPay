{
  "name": "stellar-micropay",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c green,blue \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test:all": "npm test --prefix backend && npm test --prefix frontend && make contract-test",
    "prepare": "lefthook install && simple-git-hooks"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.59.1",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autocannon": "8.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "playwright": "^1.59.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.0.0"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1"
  },
  "engines": {
    "node": "20.19.5"
  },
  "keywords": [
    "stellar",
    "zero-knowledge",
    "cryptography",
    "blockchain"
  ],
  "author": "Stellar MicroPay Team",
  "license": "MIT"
}
